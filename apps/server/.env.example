# Port used by Express and Socket.IO.
PORT=3001

# Exact browser origin allowed by CORS in local development.
WEB_ORIGIN=http://localhost:5173

# Use `production` only behind the production deployment configuration.
NODE_ENV=development

# Local PostgreSQL. Do not point tests at this development database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sixtynine_seconds_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sixtynine_seconds_test

# Cookie/session policy. Secure is derived from NODE_ENV and is always on in production.
SESSION_TTL_MS=2592000000
SESSION_COOKIE_NAME=69s_session
COOKIE_SAME_SITE=lax

# Railway terminates TLS one hop in front of Express. Keep 0 for direct local traffic.
TRUST_PROXY_HOPS=0

# Per-process/IP credential attempt limit (the MVP deploys one server replica).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
