{
  "name": "@69-seconds/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/auth/auth.integration.test.ts src/rooms/room.integration.test.ts"
  },
  "dependencies": {
    "@69-seconds/shared": "*",
    "@node-rs/argon2": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "mysql2": "^3.24.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
