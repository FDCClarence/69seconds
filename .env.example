# Used by `npm run dev` as the browser's API and realtime origin.
VITE_SERVER_URL=http://localhost:3001

# Server listening port and permitted browser origin.
PORT=3001
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sixtynine_seconds_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sixtynine_seconds_test
SESSION_TTL_MS=2592000000
SESSION_COOKIE_NAME=69s_session
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
