{
  "name": "69-seconds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @69-seconds/shared",
    "dev": "concurrently -n shared,server,web -c yellow,cyan,magenta \"npm run dev -w @69-seconds/shared\" \"npm run dev -w @69-seconds/server\" \"npm run dev -w @69-seconds/web\"",
    "build": "npm run build -w @69-seconds/shared && npm run build -w @69-seconds/server && npm run build -w @69-seconds/web",
    "build:server": "npm run build -w @69-seconds/shared && npm run build -w @69-seconds/server",
    "build:web": "npm run build -w @69-seconds/shared && npm run build -w @69-seconds/web",
    "start": "npm run start -w @69-seconds/server",
    "pretypecheck": "npm run build -w @69-seconds/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prelint": "npm run build -w @69-seconds/shared",
    "lint": "eslint .",
    "pretest": "npm run build -w @69-seconds/shared",
    "test": "npm run test --workspaces --if-present",
    "pree2e": "npm run build -w @69-seconds/shared",
    "e2e": "playwright test",
    "e2e:fixture": "tsx e2e/fixture-server.ts",
    "db:generate": "npm run db:generate -w @69-seconds/server",
    "db:migrate": "npm run db:migrate -w @69-seconds/server"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.1",
    "eslint": "9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
